# Local Python environments and downloaded/build dependencies
.venv/
.deps/
.cc-connect/

# Python caches and test state
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Editors and operating-system metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary PDF inspection and other scratch files
tmp/

# Redundant archives and very large CBT task derivatives. The reproduction
# only needs data/CBTest/data/cbt_train.txt from the official CBT extraction.
data/cbt.tar.gz
data/weather.zip
data/CBTest/data/cbtest_*.txt
data/CBTest/data/cbt_test.txt
data/CBTest/data/cbt_valid.txt
data/CBTest/stats/

# Local build/debug logs and disposable smoke outputs
results/*.log
results/*.pstats
results/*.txt
results/**/*.log
results/**/*.pstats
results/**/*.zip
results/*smoke*
results/run_*/
results/latest/
results/*partial*
results/**/*partial*

# Regenerable streamed Fig.8 segment traces are locally auditable but total
# hundreds of MB. Commit their compact summaries, cue samples, and reports.
results/fig8_diagnostics/**/*.jsonl.gz
results/fig8_diagnostics.zip
results/fig8_diagnostics/**/*.zip

# Regenerable Fig.9 strict stage-2 runs and local script logs
results/script_logs/
results/fig9_strict/ab_*/
results/fig9_strict/debug_*/
results/fig9_strict/diagnostic_*/
results/fig9_strict/resume_*/
results/fig9_strict/smoke_*/
